# Build-time configuration for the desktop client (baked into the bundle by Vite).
# Copy to `.env` before `npm run tauri build` to target a non-local server.

# Backend REST API base URL.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Backend Socket.io origin (WebSocket session + heartbeat).
VITE_REALTIME_URL=http://localhost:3000

# NOTE: when pointing at a remote server you must also widen the webview CSP in
# src-tauri/tauri.conf.json (app.security.csp) to allow your API/WS origins, and
# add those origins to the backend's DESKTOP_ORIGINS.
# VITE_API_BASE_URL=https://obsessive-fruit-glimmer.ngrok-free.dev/api/v1
# VITE_REALTIME_URL=https://obsessive-fruit-glimmer.ngrok-free.dev
