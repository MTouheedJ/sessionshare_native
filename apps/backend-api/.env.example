# ─── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── PostgreSQL ───────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=secretpassword
DB_NAME=sessionshare
# Auto-create/update schema from entities. Defaults: true in dev, false in prod.
# Leave false in production and apply schema with `npm run migration:run`.
DB_SYNCHRONIZE=false
# Run pending migrations automatically on application boot.
DB_MIGRATIONS_RUN=false

# ─── JWT ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN_SECONDS=3600
JWT_DESKTOP_EXPIRES_IN_SECONDS=900
JWT_WS_TICKET_EXPIRES_IN_SECONDS=60

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── CORS / origins ───────────────────────────────────────────────────────
# Comma-separated origins allowed to open dashboard WebSockets and call the API.
DASHBOARD_ORIGINS=http://localhost:3001
# Desktop (Tauri) webview origins allowed to call the REST API + WebSockets.
DESKTOP_ORIGINS=http://localhost:1420,http://tauri.localhost,https://tauri.localhost,tauri://localhost

# ─── Vault encryption ─────────────────────────────────────────────────────
# AES-256-GCM key for session_vault (REQUIRED). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_ENCRYPTION_KEY=

# ─── Object storage for large artifacts: Cloudflare R2 (optional) ──────────
# When set, binaries larger than VAULT_INLINE_MAX_BYTES (and all folder bundles)
# are stored in Cloudflare R2 (S3-compatible, encrypted client-side) instead of
# inline in the DB. No per-file size cap, zero egress fees. Leave blank to keep
# everything inline. Credentials are server-only — never shipped to clients.
# Create an R2 bucket + an API token (Object Read & Write) in the Cloudflare dashboard.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vault-artifacts
# Optional: override the derived S3 endpoint (https://<account>.r2.cloudflarestorage.com).
R2_ENDPOINT=
# Files at/under this size stay inline; larger go to object storage.
VAULT_INLINE_MAX_BYTES=5242880
# Lifetime (seconds) of signed upload/download URLs.
VAULT_SIGNED_URL_TTL_SECONDS=600
